    "github-copilot/gpt-5.6-luna",
    "github-copilot/gpt-5.6-sol",
    "github-copilot/gpt-5.6-terra",
    "github-copilot/gpt-6.1-sol",
    "github-copilot/gpt-6-astra",
    "github-copilot/gpt-6-luna"
  ],
  "tuiMode": "fullscreen",
  "packages": [
    "npm:@narumitw/pi-btw",
    "npm:pi-web-access"
  ]
