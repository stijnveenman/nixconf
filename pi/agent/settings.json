    "github-copilot/claude-opus-5.5",
    "github-copilot/claude-sonnet-5.5",
    "github-copilot/claude-haiku-5.5",
    "github-copilot/gpt-6.1-sol",
    "github-copilot/gpt-6.1-terra",
    "github-copilot/gpt-6-luna"
  ],
  "tuiMode": "fullscreen",
  "packages": [
    "npm:pi-web-access"
  ]
}