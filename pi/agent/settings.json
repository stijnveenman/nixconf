{
  "lastChangelogVersion": "1.4.0",
  "theme": "system",
  "defaultProvider": "github-copilot",
  "defaultModel": "claude-sonnet-5.5",
  "hideThinkingBlock": true,
  "defaultTools": [
    "+codemode"
  ],
  "editorPaddingX": 0,
  "terminal": {
    "showTerminalProgress": true
  },
  "steeringMode": "one-at-a-time",
